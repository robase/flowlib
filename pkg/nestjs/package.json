{
  "name": "@flowlib/nestjs",
  "version": "0.0.8",
  "private": false,
  "description": "A NestJS module for executing Flowlib workflows with batch processing capabilities",
  "keywords": [
    "ai",
    "anthropic",
    "batch-processing",
    "flowlib",
    "nestjs",
    "openai",
    "workflow"
  ],
  "homepage": "https://flowlib.dev",
  "bugs": {
    "url": "https://github.com/robase/flowlib/issues"
  },
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git",
    "directory": "pkg/nestjs"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts && tsc --emitDeclarationOnly --outDir dist",
    "build:nest": "nest build",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "test": "echo \"No tests configured\"",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:debug": "vitest --inspect-brk",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@flowlib/action-kit": "workspace:*",
    "@flowlib/core": "workspace:*",
    "@flowlib/db": "workspace:*",
    "@flowlib/http": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@swc/core": "^1.12.11",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "drizzle-kit": "^0.31.4",
    "tsdown": "^0.21.10",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^4.1.4"
  }
}
