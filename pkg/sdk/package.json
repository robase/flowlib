{
  "name": "@flowlib/sdk",
  "version": "0.0.2",
  "description": "Unified authoring SDK for Flowlib flows — defineFlow, core node helpers, and the canonical serializer",
  "keywords": [
    "flows",
    "flowlib",
    "sdk"
  ],
  "homepage": "https://flowlib.dev",
  "bugs": {
    "url": "https://github.com/robase/flowlib/issues"
  },
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git",
    "directory": "pkg/sdk"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./transform": {
      "types": "./dist/transform/index.d.mts",
      "import": "./dist/transform/index.mjs",
      "require": "./dist/transform/index.cjs"
    },
    "./evaluator": {
      "types": "./dist/evaluator/index.d.mts",
      "import": "./dist/evaluator/index.mjs",
      "require": "./dist/evaluator/index.cjs"
    },
    "./actions": {
      "types": "./dist/generated/index.d.mts",
      "import": "./dist/generated/index.mjs",
      "require": "./dist/generated/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-actions": "node scripts/gen-actions.mjs",
    "gen-actions:check": "node scripts/gen-actions.mjs && git diff --exit-code src/generated"
  },
  "dependencies": {
    "@flowlib/action-kit": "workspace:*",
    "@flowlib/actions": "workspace:*",
    "jiti": "^2.4.2",
    "typescript": "^5.8.3",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsdown": "0.21.9",
    "vitest": "^4.1.4"
  }
}
