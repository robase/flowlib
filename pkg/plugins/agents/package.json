{
  "name": "@flowlib/agents",
  "version": "0.0.1",
  "description": "Code-editing AI agents plugin for Flowlib — Claude Code, opencode, raw-LLM providers; Cloudflare Sandbox workspaces; durable-object-backed sessions",
  "keywords": [
    "flowlib",
    "plugin",
    "agents",
    "ai",
    "claude-code",
    "opencode",
    "cloudflare"
  ],
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git",
    "directory": "pkg/plugins/agents"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/backend/index.cjs",
  "module": "dist/backend/index.mjs",
  "types": "dist/backend/index.d.mts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.mts",
        "import": "./dist/browser/index.mjs"
      },
      "types": "./dist/backend/index.d.mts",
      "import": "./dist/backend/index.mjs",
      "require": "./dist/backend/index.cjs"
    },
    "./ui": {
      "types": "./dist/frontend/index.d.mts",
      "import": "./dist/frontend/index.mjs",
      "require": "./dist/frontend/index.cjs"
    },
    "./types": {
      "types": "./dist/shared/types.d.mts",
      "import": "./dist/shared/types.mjs",
      "require": "./dist/shared/types.cjs"
    },
    "./events": {
      "types": "./dist/shared/events.d.mts",
      "import": "./dist/shared/events.mjs",
      "require": "./dist/shared/events.cjs"
    }
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --outDir dist",
    "build:w": "tsdown --watch",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@flowlib/action-kit": "workspace:*",
    "@flowlib/actions": "workspace:*",
    "@flowlib/core": "workspace:*",
    "@flowlib/db": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20251111.0",
    "@types/node": "^20.11.20",
    "tsdown": "^0.21.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@cloudflare/sandbox": "*",
    "@cloudflare/workers-types": "^4.0.0",
    "@opencode-ai/sdk": "*",
    "agents": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@cloudflare/sandbox": {
      "optional": true
    },
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "agents": {
      "optional": true
    }
  }
}
