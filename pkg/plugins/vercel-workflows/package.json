{
  "name": "@flowlib/vercel-workflows",
  "version": "0.0.6",
  "description": "Run Flowlib primitive flows as Vercel Workflows — server plugin and single-step wrapping helpers",
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git",
    "directory": "pkg/plugins/vercel-workflows"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.mts",
        "import": "./dist/browser.mjs"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs",
      "require": "./dist/runtime/index.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.mts",
      "import": "./dist/compiler/index.mjs",
      "require": "./dist/compiler/index.cjs"
    },
    "./ui": {
      "types": "./dist/frontend/index.d.mts",
      "import": "./dist/frontend/index.mjs",
      "require": "./dist/frontend/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:w": "tsdown --watch",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flowlib/action-kit": "workspace:*",
    "@flowlib/actions": "workspace:*",
    "@flowlib/core": "workspace:*",
    "@flowlib/primitives": "workspace:*",
    "@flowlib/sdk": "workspace:*"
  },
  "devDependencies": {
    "@flowlib/ui": "workspace:*",
    "@types/react": "18.3.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "tsdown": "latest",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@flowlib/ui": "workspace:^",
    "lucide-react": ">=0.475.0",
    "react": ">=18.0.0",
    "workflow": "*"
  },
  "peerDependenciesMeta": {
    "@flowlib/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "workflow": {
      "optional": true
    }
  }
}
