{
  "name": "@flowlib/user-auth",
  "version": "0.0.1",
  "description": "Better Auth plugin for Flowlib — adds user authentication, session management, identity resolution, and auth UI components",
  "keywords": [
    "auth",
    "authentication",
    "better-auth",
    "flowlib",
    "plugin",
    "workflow"
  ],
  "homepage": "https://flowlib.dev",
  "bugs": {
    "url": "https://github.com/robase/flowlib/issues"
  },
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git",
    "directory": "pkg/plugins/auth"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "dist/backend/index.cjs",
  "module": "dist/backend/index.mjs",
  "types": "dist/backend/index.d.mts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.mts",
        "import": "./dist/browser/index.mjs"
      },
      "types": "./dist/backend/index.d.mts",
      "import": "./dist/backend/index.mjs",
      "require": "./dist/backend/index.cjs"
    },
    "./ui": {
      "types": "./dist/frontend/index.d.mts",
      "import": "./dist/frontend/index.mjs",
      "require": "./dist/frontend/index.cjs"
    },
    "./types": {
      "types": "./dist/shared/types.d.mts",
      "import": "./dist/shared/types.mjs",
      "require": "./dist/shared/types.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --outDir dist",
    "build:w": "tsdown --watch",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.0",
    "@flowlib/core": "workspace:*",
    "better-auth": "^1.6.0",
    "clsx": "^2.1.1",
    "kysely": "^0.28.14",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@flowlib/ui": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^20.11.20",
    "@types/react": "18.3.7",
    "@types/react-dom": "18.3.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.21.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@flowlib/ui": "workspace:*",
    "@tanstack/react-query": ">=5.0.0",
    "better-sqlite3": ">=9.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@flowlib/ui": {
      "optional": true
    }
  }
}
