{
  "name": "flowlib",
  "version": "0.0.1",
  "private": true,
  "description": "Complete workflow management system with React frontend and NestJS backend",
  "keywords": [
    "Flowlib",
    "ai",
    "backend",
    "batch-processing",
    "components",
    "flowlib",
    "frontend",
    "nestjs",
    "react",
    "typescript",
    "workflow"
  ],
  "homepage": "https://flowlib.dev",
  "bugs": {
    "url": "https://github.com/robase/flowlib/issues"
  },
  "license": "MIT",
  "author": "robase <team@flowlib.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/robase/flowlib.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter '@flowlib/*' run build",
    "link:all": "pnpm build && pnpm --filter '@flowlib/*' exec npm link",
    "build:core": "pnpm --filter '@flowlib/core' run build",
    "build:ui": "pnpm --filter '@flowlib/ui' run build",
    "build:nestjs": "pnpm --filter '@flowlib/nestjs' run build",
    "build:express": "pnpm --filter '@flowlib/express' run build",
    "build:nextjs": "pnpm --filter '@flowlib/nextjs' run build",
    "dev": "bash scripts/dev.sh",
    "dev:packages": "pnpm --filter '@flowlib/*' --parallel run dev",
    "dev:express-example": "pnpm --filter '...flowlib-express-simple' --parallel run dev",
    "dev:vite-example": "pnpm --filter '...flow-executor' --parallel run dev",
    "dev:all": "pnpm --filter '@flowlib/*' --parallel run dev",
    "dev:fullstack": "bash scripts/dev-fullstack.sh",
    "dev:next": "bash scripts/dev-next.sh",
    "dev:nest": "bash scripts/dev-nest.sh",
    "dev:ext": "bash scripts/dev-ext.sh",
    "dev:watch-all": "pnpm --filter '...flowlib-express-simple' --filter '...flow-executor' --parallel run dev",
    "test": "pnpm --filter '@flowlib/core' run test:unit && pnpm --filter '@flowlib/cli' --filter '@flowlib/user-auth' --filter '@flowlib/version-control' run test",
    "test:int": "pnpm --filter '@flowlib/core' run test:integration",
    "test:all": "pnpm -r --filter './pkg/**' run test",
    "test:e2e": "pnpm --filter '@flowlib/core' run test:e2e",
    "test:pw": "node scripts/run-playwright-with-port-check.mjs --project api --project frontend --project e2e --project critical-paths --project auth",
    "test:pw:force-kill": "node scripts/run-playwright-with-port-check.mjs --force-kill-ports --project api --project frontend --project e2e --project critical-paths --project auth",
    "test:pw:ui": "node scripts/run-playwright-with-port-check.mjs --ui",
    "test:pw:headed": "node scripts/run-playwright-with-port-check.mjs --headed",
    "ux:capture": "npx playwright test --config playwright/playwright.config.ts --project visual-audit",
    "ux:analyze": "npx tsx playwright/visual-audit/analyze.ts",
    "ux:audit": "pnpm ux:capture && pnpm ux:analyze",
    "setup:credentials": "bash scripts/setup-credentials.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "rm -rf dist && pnpm --filter '@flowlib/*' run clean",
    "changeset": "changeset",
    "version-packages": "node scripts/force-patch-changesets.mjs && changeset version",
    "release": "pnpm build && pnpm publish -r --access public --no-git-checks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@flowlib/cli": "workspace:*",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@types/pg": "^8.15.4",
    "@xyflow/react": "^12.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "mysql2": "^3.14.2",
    "openai": "^5.9.0",
    "pg": "^8.16.3",
    "prisma": "^6.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.13",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "eslint-plugin-security": "^4.0.0",
    "express": "^5.2.1",
    "knip": "^6.3.0",
    "msw": "^2.11.2",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "rollup": "^4.60.2",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.5.0"
}
